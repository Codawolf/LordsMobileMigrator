@page
@model WatchedTargetsModel
@{
    ViewData["Title"] = "Watched Targets - Lords Mobile Migrator";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap bg-dark text-white p-3 rounded mb-3 shadow-sm">
        <div>
            <h4 class="mb-0">🛡️ Lords Mobile Migration & Trend Tracker</h4>
            <small class="text-warning fw-bold">
                🕒 Last Upload: <span class="local-timestamp" data-utc="@Model.LastUploadDisplay">Loading...</span>
            </small>
        </div>
        <a href="/" class="btn btn-outline-light btn-sm">🔙 Back to Main Settings</a>
    </div>

    @if (Model.WatchedKingdoms.Any())
    {
        <ul class="nav nav-tabs mt-4">
            <li class="nav-item">
                <a class="nav-link fw-bold text-danger" href="/">🔥 Active Chalice Kingdoms</a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold text-success" href="/OpenTargets">✅ Open Targets</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active fw-bold text-info shadow-sm" href="#">👁️ Watched Kingdoms (@Model.WatchedKingdoms.Count)</a>
            </li>
        </ul>

        <div class="border border-top-0 p-3 bg-white shadow-sm rounded-bottom">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mt-2 table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th onclick="sortTable(0, 'num')" style="cursor: pointer;">Kingdom ↕️</th>
                            <th onclick="sortTable(1, 'num')" style="cursor: pointer;">Total Castles ↕️</th>
                            <th onclick="sortTable(2, 'num')" style="cursor: pointer;">Active Change ↕️</th>
                            <th>Inactive Castles</th>
                            <th>Inactive Change</th>
                            <th>Scroll Cost</th>
                            <th>P50 Might</th>
                            <th>Champ Accessories</th>
                            <th onclick="sortWowColumn(8)" style="cursor: pointer;">Time Till Wonder War ↕️</th>
                            <th>Status</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var k in Model.WatchedKingdoms)
                        {
                            <tr class="@(k.IsDisregarded ? "table-warning border-warning" : "table-light")">
                                <td class="fw-bold">
                                    <button type="button"
                                            class="btn btn-sm btn-link p-0 fw-bold text-decoration-none text-success"
                                            data-bs-toggle="modal"
                                            data-bs-target="#trendModal"
                                            data-kd="@k.KingdomNumber">
                                        #@k.KingdomNumber 📊
                                    </button>
                                </td>
                                <td>@k.CurrentActive.ToString("N0")</td>
                                <td class="@(k.ActiveChange > 0 ? "text-success fw-bold" : k.ActiveChange < 0 ? "text-danger" : "")">
                                    @(k.ActiveChange >= 0 ? "+" : "")@k.ActiveChange
                                </td>
                                <td>@k.CurrentInactive.ToString("N0")</td>
                                <td class="@(k.InactiveChange > 0 ? "text-warning" : "text-muted")">
                                    @(k.InactiveChange >= 0 ? "+" : "")@k.InactiveChange
                                </td>
                                <td>📜 @k.MigrationCost</td>
                                <td>@k.P50MightDisplay</td>
                                <td>🛡️ @k.AccessoriesChamps</td>
                                <td>
                                    <!-- FIXED: Pulls your live remaining minutes from the updated Open Targets backend model -->
                                    <span class="wow-countdown" data-initial-minutes="@k.TimeTillWowMinutes">
                                        🕒 Calculating...
                                    </span>
                                </td>
                                <td class="fw-bold">
                                    @if (k.IsDisregarded)
                                    {
                                        <span class="text-danger">⚠️ Disregarded</span>
                                    }
                                    else
                                    {

                                        <span class="text-success">⭐ Prime Target</span>
                                    }
                                </td>
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary py-0 text-start text-truncate w-100 px-1"
                                            style="max-width: 130px; font-size:0.75rem;"
                                            data-bs-toggle="modal"
                                            data-bs-target="#noteModal"
                                            data-kd="@k.KingdomNumber"
                                            data-note-current="@k.NotesDisplay"
                                            id="noteBtn-@k.KingdomNumber">
                                        ✏️ @(string.IsNullOrWhiteSpace(k.NotesDisplay) ? "Add Note..." : k.NotesDisplay)
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4 shadow-sm">
            No entries found. Input a space-separated string of domain IDs inside the **Watched Kingdoms** textbox on the <a href="/" class="alert-link">main settings page</a>.
        </div>
    }
    <!-- SYSTEM TREND MODAL POPUP GATEWAY -->
    <div class="modal fade" id="trendModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="trendModalTitle">Kingdom Population Trend</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    <div style="position: relative; height:350px; width:100%;">
                        <canvas id="kingdomTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- INDEPENDENT REAL-TIME SYSTEM NOTE MODAL POPUP -->
    <div class="modal fade" id="noteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title" id="noteModalTitle">📝 Kingdom Note</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-light p-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="noteTargetKd" />
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Strategic Directives</label>
                        <textarea id="noteFieldText" class="form-control" rows="4" placeholder="Enter target profiles notes..."></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-success btn-sm px-4" onclick="executeNoteSave()">Save Strategy</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Local Chart.js engine link -->
    <script src="~/js/chart.js" asp-append-version="true"></script>
</div>

<script>
    let globalChartInstance = null;

    document.addEventListener("DOMContentLoaded", function() {

        // ==========================================
        // 1. DYNAMIC REAL-TIME TIMED COUNTDOWN ENGINE
        // ==========================================
        const timestampEl = document.querySelector('.local-timestamp');
        const fileUtcString = timestampEl ? timestampEl.getAttribute('data-utc') : null;

        // Calculate exactly when the file was processed in milliseconds
        let fileUploadMs = (fileUtcString && fileUtcString !== "No Data Uploaded")
            ? new Date(fileUtcString).getTime()
            : Date.now();

        const countdownElements = document.querySelectorAll('.wow-countdown');
        countdownElements.forEach(el => {
            let initialMinutes = parseInt(el.getAttribute('data-initial-minutes'));
            if (isNaN(initialMinutes) || initialMinutes <= 0) {
                el.innerHTML = '<span class="text-danger fw-bold">💥 War Active / Over</span>';
                return;
            }

            // MASTER CORRECTION math: Target Time = File Upload Time + Total Spreadsheet Duration Minutes
            // This guarantees the clock automatically accounts for time elapsed since the pull!
            let targetTime = fileUploadMs + (initialMinutes * 60 * 1000);
            let timerId = null;

            function updateClock() {
                let remainingMs = targetTime - Date.now();

                if (remainingMs <= 0) {
                    el.innerHTML = '<span class="text-danger fw-bold">⚠️ War Commencing!</span>';
                    if (timerId) clearInterval(timerId);
                    return;
                }

                let days = Math.floor(remainingMs / (1000 * 60 * 60 * 24));
                let hours = Math.floor((remainingMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                let minutes = Math.floor((remainingMs % (1000 * 60 * 60)) / (1000 * 60));
                let seconds = Math.floor((remainingMs % (1000 * 60)) / 1000);

                let paddedHours = String(hours).padStart(2, '0');
                let paddedMinutes = String(minutes).padStart(2, '0');
                let paddedSeconds = String(seconds).padStart(2, '0');

                if (days === 0 && hours < 24) {
                    el.innerHTML = `<span class="badge bg-danger text-white">⚠️ ${paddedHours}:${paddedMinutes}:${paddedSeconds}</span>`;
                } else {
                    el.innerHTML = `<span class="text-dark font-monospace fw-bold">🕒 ${days}d, ${paddedHours}:${paddedMinutes}:${paddedSeconds}</span>`;
                }
            }

            updateClock();
            timerId = setInterval(updateClock, 1000);
        });

        // ==========================================
        // 2. BROWSER LOCAL TIMEZONE CONVERTER ENGINE
        // ==========================================
        if (timestampEl) {
            if (fileUtcString && fileUtcString !== "No Data Uploaded") {
                const date = new Date(fileUtcString);
                timestampEl.innerText = date.toLocaleString([], { dateStyle: 'short', timeStyle: 'short' });
            } else {
                timestampEl.innerText = "No Data Uploaded";
            }
        }

        // ==========================================
        // 3. GRAPH TREND CHART POPUP ENGINE
        // ==========================================
        const modalElement = document.getElementById('trendModal');
        if (modalElement) {
            modalElement.addEventListener('shown.bs.modal', function(event) {
                const button = event.relatedTarget;
                const kingdomNum = button.getAttribute('data-kd');

                document.getElementById("trendModalTitle").innerText = `📊 Kingdom #${kingdomNum} Population Timeline`;

                fetch(`/?handler=KingdomHistory&kingdomNumber=${kingdomNum}`)
                    .then(res => res.json())
                    .then(data => {
                        const labels = data.map(item => item.date);
                        const castleCounts = data.map(item => item.castles);

                        const chartCanvas = document.getElementById('kingdomTrendChart');
                        if (!chartCanvas) return;

                        const ctx = chartCanvas.getContext('2d');
                        if (globalChartInstance) { globalChartInstance.destroy(); }

                        globalChartInstance = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'Total Castle Count',
                                    data: castleCounts,
                                    borderColor: '#198754',
                                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                                    borderWidth: 3,
                                    tension: 0.2,
                                    fill: true
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    y: { beginAtZero: false, ticks: { precision: 0 } }
                                }
                            }
                        });
                    });
            });
        }
    });

    // ==========================================
    // 4. INTERACTIVE ROW SORTING ENGINES
    // ==========================================
    function sortTable(columnIndex, type) {
        const table = document.querySelector(".table-hover") || document.querySelector(".table");
        if (!table) return;
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr"));
        let isAscending = table.getAttribute("data-sort-dir") !== "asc";
        table.setAttribute("data-sort-dir", isAscending ? "asc" : "desc");

        rows.sort((rowA, rowB) => {
            let cellA = rowA.cells[columnIndex].innerText.replace(/[^0-9.-]/g, '').trim();
            let cellB = rowB.cells[columnIndex].innerText.replace(/[^0-9.-]/g, '').trim();
            if (type === 'num') return isAscending ? parseFloat(cellA) - parseFloat(cellB) : parseFloat(cellB) - parseFloat(cellA);
            return isAscending ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
        });
        rows.forEach(row => tbody.appendChild(row));
    }

    function sortWowColumn(columnIndex) {
        const table = document.querySelector(".table-hover") || document.querySelector(".table");
        if (!table) return;
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr"));
        let isAscending = table.getAttribute("data-wow-sort-dir") !== "asc";
        table.setAttribute("data-wow-sort-dir", isAscending ? "asc" : "desc");

        rows.sort((rowA, rowB) => {
            const spanA = rowA.cells[columnIndex].querySelector('.wow-countdown');
            const spanB = rowB.cells[columnIndex].querySelector('.wow-countdown');
            let minutesA = spanA ? parseInt(spanA.getAttribute('data-initial-minutes')) : 0;
            let minutesB = spanB ? parseInt(spanB.getAttribute('data-initial-minutes')) : 0;
            if (isNaN(minutesA) || minutesA <= 0) minutesA = isAscending ? 999999 : -999999;
            if (isNaN(minutesB) || minutesB <= 0) minutesB = isAscending ? 999999 : -999999;
            return isAscending ? minutesA - minutesB : minutesB - minutesA;
        });
        rows.forEach(row => tbody.appendChild(row));
    }
    // CENTRALIZED LIVE NOTES RUNTIME TRACKER
    const noteModalElement = document.getElementById('noteModal');
    if (noteModalElement) {
        noteModalElement.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            const kingdomNum = button.getAttribute('data-kd');
            const currentNote = button.getAttribute('data-note-current') || "";

            document.getElementById("noteModalTitle").innerText = `📝 Strategic Intelligence: Kingdom #${kingdomNum}`;
            document.getElementById("noteTargetKd").value = kingdomNum;
            document.getElementById("noteFieldText").value = currentNote;
        });
    }

    window.executeNoteSave = function() {
        const kingdomNum = document.getElementById("noteTargetKd").value;
        const textValue = document.getElementById("noteFieldText").value;

        const formData = new FormData();
        formData.append("kingdomNumber", kingdomNum);
        formData.append("noteText", textValue);

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        fetch('/Index?handler=SaveKingdomNote', {
            method: 'POST',
            body: formData,
            headers: { "RequestVerificationToken": token }
        }).then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Update button label inside grid table instantly without reloading page layout canvas
                    const btn = document.getElementById(`noteBtn-${kingdomNum}`);
                    if (btn) {
                        btn.setAttribute('data-note-current', data.currentText);
                        btn.innerText = data.currentText.trim() === "" ? "✏️ Add Note..." : `✏️ ${data.currentText}`;
                    }

                    // Hide modal container cleanly
                    bootstrap.Modal.getInstance(document.getElementById('noteModal')).hide();
                }
            });
    };
</script>

